# 三班倒打卡系统 —— 环境变量样例
# 复制为 app/.env 后按需修改；不要提交真实口令。

# ── 数据库 ─────────────────────────────────────────────
DATABASE_URL=postgresql://app:app@localhost:5432/app

# ── 运行模式 ───────────────────────────────────────────
# 演示/测试模式：开启后允许 X-Test-User/X-Test-Role 与 /auth/login 伪造身份。
# 正式部署必须为 0。默认 0。
FDC_TEST_MODE=0
TZ=Asia/Shanghai
PORT=3000

# ── 前端静态目录（可选；留空则不挂载静态站点）────────────
STATIC_ADMIN=
STATIC_H5=

# ── 认证 ───────────────────────────────────────────────
# 超级管理员 TOTP base32 密钥；留空 = 超管入口关闭。
FDC_ADMIN_TOTP_SECRET=
# 本地身份启动器签名密钥；留空 = /h5/test/auth 与 /h5/test/employees 全部 403。
# 公开版不内置任何共享密钥，正式环境务必留空。
FDC_TEST_LOGIN_SECRET=

# ── 定时任务 ───────────────────────────────────────────
FDC_ESCALATION_TZ=Asia/Shanghai
FDC_ATTENDANCE_SYNC_SCHEDULER_ENABLED=true

# ── 请求审计（可选 Redis Stream）───────────────────────
# 留空 = 同步写库；部署 Compose 时指向 redis 服务。
FDC_REQUEST_AUDIT_REDIS_URL=
FDC_REQUEST_AUDIT_STREAM=fdc:request-audit
FDC_REQUEST_AUDIT_GROUP=fdc-request-audit-writers

# ── 可选集成：钉钉微应用 ───────────────────────────────
# 未配置时相关接口优雅降级，不发起外部连接。
DINGTALK_CORP_ID=
DINGTALK_AGENT_ID=
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=

# ── 可选集成：外部考勤源（MySQL 只读视图）──────────────
# 未配置 ATTENDANCE_MYSQL_HOST 时集成视为未启用。
ATTENDANCE_MYSQL_HOST=
ATTENDANCE_MYSQL_PORT=3306
ATTENDANCE_MYSQL_USER=
ATTENDANCE_MYSQL_PASSWORD=
ATTENDANCE_MYSQL_DB=
ATTENDANCE_MYSQL_VIEW=
ATTENDANCE_RESULT_VIEW=

# ── 演示数据 ───────────────────────────────────────────
# 仅 `python -m app.seed` 使用；正式部署留空。
FDC_CSV_DIR=
